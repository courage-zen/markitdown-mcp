# MarkItDown MCP server configuration
# Copy to .env and adjust for your deployment.

# --- Server binding ---
# MCP_HOST: bind address (default 0.0.0.0; use 127.0.0.1 to restrict to localhost)
MCP_HOST=0.0.0.0
# MCP_PORT: listen port (default 8000)
MCP_PORT=8000
# MCP_LOG_LEVEL: debug | info | warning | error
MCP_LOG_LEVEL=info

# --- Authentication ---
# MCP_AUTH_KEY: pre-shared key(s) for Bearer-token auth. Leave empty to disable auth
# (not recommended for anything reachable outside localhost). Multiple keys can be
# comma-separated, e.g. agent1-key,agent2-key
MCP_AUTH_KEY=change-me

# --- File access (optional) ---
# MARKITDOWN_SAFE_DIRS: extra directories the server may read from, in addition
# to the working directory and the system temp directory. Multiple entries are
# separated by the OS path separator (":" on Linux/macOS). Only absolute paths
# that exist are honored.
# MARKITDOWN_SAFE_DIRS=/data/docs:/data/imports

# --- S3 input for convert_file (optional; names mirror the multica backend) ---
# When configured, convert_file accepts an s3_key and fetches the object itself.
# S3_BUCKET: bucket to read objects from (e.g. multica-uploads)
# S3_BUCKET=
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY: credentials for the bucket
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL: custom endpoint for MinIO/R2, e.g.
# http://multica-minio.<namespace>.svc.cluster.local:9000 (empty = real AWS S3)
# AWS_ENDPOINT_URL=
# S3_REGION: region (default us-east-1; falls back to AWS_REGION)
# S3_REGION=us-east-1
# S3_USE_PATH_STYLE: true/false; unset = path-style iff AWS_ENDPOINT_URL is set
# S3_USE_PATH_STYLE=true
# S3_KEY_PREFIXES: comma-separated key-prefix allowlist, matched segment-aware
# (e.g. "workspaces/11111111-1111-1111-1111-111111111111"). Empty = no
# restriction: only safe when every MCP_AUTH_KEY holder may read the whole bucket.
# S3_KEY_PREFIXES=
